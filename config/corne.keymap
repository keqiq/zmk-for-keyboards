#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/ext_power.h>
/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick_tap_ms = <0>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;

            quick-tap-ms = <180>;
            global-quick-tap;
        };

        ltq: ltq {
            compatible = "zmk,behavior-hold-tap";
            label = "LTQ";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <600>;
            global-quick-tap;
            quick-tap-ms = <400>;
        };
    };

    combos {
        compatible = "zmk,combos";

        left_bkt {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <4 3>;
            timeout-ms = <50>;
        };

        right_bkt {
            bindings = <&kp RBKT>;
            key-positions = <7 8>;
            timeout-ms = <50>;
        };

        left_par {
            bindings = <&kp LEFT_PARENTHESIS>;
            key-positions = <15 16>;
            timeout-ms = <50>;
        };

        right_par {
            bindings = <&kp RIGHT_PARENTHESIS>;
            key-positions = <19 20>;
            timeout-ms = <50>;
        };

        left_brace {
            bindings = <&kp LEFT_BRACE>;
            key-positions = <27 28>;
            timeout-ms = <50>;
        };

        right_brace {
            bindings = <&kp RIGHT_BRACE>;
            key-positions = <32 31>;
            timeout-ms = <50>;
        };

        equal {
            bindings = <&kp EQUAL>;
            key-positions = <16 19>;
            timeout-ms = <50>;
        };

        plus {
            bindings = <&kp PLUS>;
            key-positions = <4 7>;
            timeout-ms = <50>;
        };

        minus {
            bindings = <&kp MINUS>;
            key-positions = <28 31>;
            timeout-ms = <50>;
        };

        star {
            bindings = <&kp STAR>;
            key-positions = <3 8>;
            timeout-ms = <50>;
        };

        bac {
            bindings = <&kp BACKSLASH>;
            key-positions = <15 20>;
            timeout-ms = <50>;
        };

        pipe {
            bindings = <&kp PIPE>;
            key-positions = <27 32>;
            timeout-ms = <50>;
        };

        under {
            bindings = <&kp UNDER>;
            key-positions = <17 18>;
            timeout-ms = <50>;
        };

        tilde {
            bindings = <&kp TILDE>;
            key-positions = <5 6>;
            timeout-ms = <50>;
        };

    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp ESC     &kp Q           &kp W           &kp E        &kp R             &kp T             &kp Y        &kp U             &kp I           &kp O            &kp P               &kp BSPC
&kp TAB     &kp A           &hm LEFT_ALT S  &hm LCTRL D  &hm LEFT_SHIFT F  &kp G             &kp H        &hm RSHIFT J      &hm RCTRL K     &hm RIGHT_ALT L  &kp SEMICOLON       &kp SQT
&lt 3 LGUI  &kp Z           &kp X           &kp C        &kp V             &kp B             &kp N        &kp M             &kp COMMA       &kp DOT          &kp FSLH            &kp BSLH
                                            &kp UP       &kp LEFT          &lt 1 SPACE       &lt 2 ENTER  &kp RIGHT         &kp DOWN
            >;
        };

        lower_layer {
            bindings = <
&trans    &kp EXCL  &kp AT  &kp HASH  &kp DLLR  &kp PRCNT       &kp CARET   &kp AMPS   &kp STAR   &kp PLUS   &kp MINUS   &trans
&trans    &kp N1    &kp N2  &kp N3    &kp N4    &kp N5          &kp N6      &kp N7     &kp N8     &kp N9     &kp N0      &trans
&trans    &trans    &trans  &trans    &trans    &trans          &trans      &trans     &trans     &trans     &trans      &trans
                            &trans    &trans    &trans          &trans      &trans     &trans
            >;
        };

        raise_layer {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans  &trans  &trans  &trans
&kp F12 &kp F1  &kp F2  &kp F3  &kp F4  &kp F5          &kp F6  &kp F7  &kp F8  &kp F9  &kp F10 &kp F11
&trans  &trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans          &trans  &trans  &trans
            >;
        };

        layer_3 {
            bindings = <
&trans  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3          &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &bt BT_CLR    &trans        &trans        &ext_power EP_TOG     &rgb_ug RGB_TOG         &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans        &trans        &trans        &trans                &trans                  &trans  &trans  &trans  &trans  &trans  &trans
                                    &trans        &trans                &bt BT_PRV              &BT_NXT &trans  &trans
            >;
        };
        extra1 {
            status = "reserved";
        };
        extra2 {
            status = "reserved";
        };
        extra3 {
            status = "reserved";
        };
        extra4 {
            status = "reserved";
        };

    };
};
